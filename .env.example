# ─────────────────────────────────────────────────────────────────────────────
# Unstuck Internal Dashboard — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file, fill in the real values, and add them to Render.com under:
#   Dashboard → your service → Environment → Add Environment Variable
#
# DO NOT commit a filled-in copy of this file to Git.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase (Mail Merge Tool — Sender Profiles) ──────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Your project's API URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Public anon key (safe for server-side use; NOT the service_role key)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── Copy Bank — Slack Approval Notifications ──────────────────────────────────
# Required for the copy approval workflow (Request Approval → Slack notify → Approve & Publish)
#
# WEBHOOK URL
#   1. Go to https://api.slack.com/apps → Create New App → From scratch
#   2. Name: "Unstuck Copy Bank", select your workspace → Create App
#   3. Sidebar → Incoming Webhooks → Activate Incoming Webhooks ON
#   4. Add New Webhook to Workspace → select your #copy-approvals channel → Allow
#   5. Copy the Webhook URL below
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# REVIEWER SLACK MEMBER IDs  (used to @mention reviewers in the notification)
#   Find each ID: click their Slack profile → ⋮ (three dots) → Copy member ID
#   Format: U012AB3CD
SLACK_OLLIE_ID=U0XXXXXXX
SLACK_CHRIS_ID=U0YYYYYYY
SLACK_LEO_ID=U0ZZZZZZZ
